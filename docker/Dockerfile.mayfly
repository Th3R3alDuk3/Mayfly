FROM node:25-bookworm

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates build-essential \
        git ripgrep fd-find \
        python3 python3-pip python3-venv \
        libnode-dev tzdata \
    && rm -rf /var/lib/apt/lists/*

ARG PIP_INDEX_URL
ARG PIP_TRUSTED_HOST
ARG NPM_REGISTRY
ARG NPM_STRICT_SSL

ENV PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_TRUSTED_HOST=${PIP_TRUSTED_HOST} \
    NPM_CONFIG_REGISTRY=${NPM_REGISTRY} \
    NPM_CONFIG_STRICT_SSL=${NPM_STRICT_SSL}

RUN pip install --no-cache-dir --break-system-packages uv ruff basedpyright
RUN npm install --ignore-scripts -g opencode-ai@1.14.33 @openchamber/web@1.9.10

RUN userdel -r node 2>/dev/null || true \
    && useradd -u 1000 -m -s /bin/bash user

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

USER user
WORKDIR /home/user

# Port comes from MAYFLY_PORT env (set by app at container runtime).

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
