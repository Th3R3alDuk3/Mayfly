FROM node:24-trixie-slim

# Build only; sessions take their indexes from the server's .env.
ARG PIP_INDEX_URL
ARG PIP_TRUSTED_HOST
ARG NPM_CONFIG_REGISTRY
ARG NPM_CONFIG_STRICT_SSL
ARG OPENCODE_VERSION=1.18.31
ARG OPENCHAMBER_VERSION=1.24.1

# POSIX locale breaks multibyte input in the built-in terminal.
ENV LANG=C.UTF-8 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Accepts the expired release files of an outdated Debian mirror.
RUN apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl git ripgrep fd-find python3 python3-venv \
    && rm -rf /var/lib/apt/lists/*

# A venv on PATH keeps a plain `pip install` working; Debian's system Python refuses it.
ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:${PATH}

RUN python3 -m venv ${VIRTUAL_ENV} \
    && pip install --no-cache-dir uv ruff

# OpenChamber's openai@4 wants zod 3 next to its zod 4; the tree is the same without peers.
RUN npm install --ignore-scripts --legacy-peer-deps -g \
        opencode-ai@${OPENCODE_VERSION} \
        @openchamber/web@${OPENCHAMBER_VERSION} \
    && node /usr/local/lib/node_modules/opencode-ai/postinstall.mjs \
    && npm cache clean --force

# The base image ships its own uid 1000; the venv is the agent's, so it owns it.
RUN userdel -r node && useradd -u 1000 -m -s /bin/bash user \
    && chown -R user:user ${VIRTUAL_ENV}
USER user

# Created here because builders without BuildKit make WORKDIR owned by root.
RUN mkdir -p ~/workspace ~/.config/openchamber ~/.config/opencode && cd ~/.config/opencode \
    # OpenCode installs this on first start; offline that stalls for minutes.
    && npm install --ignore-scripts --legacy-peer-deps --no-audit --no-fund --save-exact \
        @opencode-ai/plugin@${OPENCODE_VERSION} \
    && npm cache clean --force

WORKDIR /home/user/workspace

ENV OPENCODE_CONFIG=/etc/mayfly/opencode.json \
    OPENCODE_DISABLE_AUTOUPDATE=1 \
    OPENCODE_DISABLE_SHARE=1 \
    OPENCODE_DISABLE_LSP_DOWNLOAD=1 \
    OPENCODE_DISABLE_MODELS_FETCH=1 \
    OPENCHAMBER_HOST=0.0.0.0

# Fails without a DNS lookup instead of calling home.
ENV OPENCHAMBER_UPDATE_API_URL=http://127.0.0.1:1/update

EXPOSE 4096

# OpenChamber writes its settings, so the mounted copy is put in place instead of read from there.
CMD ["sh", "-c", "cp /etc/mayfly/openchamber.json ~/.config/openchamber/settings.json && exec openchamber --foreground --port 4096"]
