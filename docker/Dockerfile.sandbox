FROM node:26-trixie-slim AS node

FROM ghcr.io/astral-sh/uv:python3.14-trixie-slim

# Build only; sessions take their indexes from the server's .env.
ARG PIP_INDEX_URL
ARG PIP_TRUSTED_HOST
ARG NPM_CONFIG_REGISTRY
ARG NPM_CONFIG_STRICT_SSL
ARG OPENCODE_VERSION=2.2.3
ARG OPENCHAMBER_VERSION=2.5.3

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    NPM_CONFIG_UPDATE_NOTIFIER=false

# Accepts the expired release files of an outdated Debian mirror.
RUN apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends \
        curl fd-find file git jq less libatomic1 make nano patch procps \
        ripgrep sqlite3 tree unzip wget zip \
    && ln -s /usr/bin/fdfind /usr/local/bin/fd \
    && rm -rf /var/lib/apt/lists/*

COPY --from=node /usr/local/bin/node /usr/local/bin/
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

# Scripts off: nothing comes from GitHub. The launcher keeps one 250 MB binary.
RUN npm install --ignore-scripts -g \
        @opencode/cli@${OPENCODE_VERSION} \
        @openchamber/web@${OPENCHAMBER_VERSION} \
    && cd /usr/local/lib/node_modules/@opencode/cli \
    && node postinstall.mjs \
    && rm -rf node_modules \
    && npm cache clean --force

# Hides what needs the internet and leaves providers to the OpenCode config.
RUN mkdir /etc/openchamber \
    && echo '{"enterpriseMode": true, "allowNetworkAccess": true, "hideBuiltinSkillCatalogs": true, "opencodeBinary": "/usr/local/bin/opencode"}' \
        > /etc/openchamber/policy.json

RUN useradd -u 1000 -m -s /bin/bash user \
    && mkdir /opt/venv && chown user:user /opt/venv
USER user

# Without root, the agent installs here. VIRTUAL_ENV would make uv warn.
ENV PATH=/opt/venv/bin:${PATH} \
    UV_TOOL_BIN_DIR=/opt/venv/bin

RUN python -m venv /opt/venv \
    && pip install --no-cache-dir \
        httpx pytest ruff \
        matplotlib numpy pandas pillow \
        openpyxl pypdf python-docx \
        beautifulsoup4 jinja2 lxml pyyaml tqdm

# Warm matplotlib's font cache.
RUN python -c "import matplotlib.pyplot"

# Created here because builders without BuildKit make WORKDIR owned by root.
RUN mkdir -p ~/workspace ~/.config/openchamber

WORKDIR /home/user/workspace

ENV OPENCODE_DISABLE_AUTOUPDATE=1 \
    OPENCODE_DISABLE_MODELS_FETCH=1 \
    OPENCHAMBER_HOST=0.0.0.0 \
    DO_NOT_TRACK=1 \
    OTEL_SDK_DISABLED=true

# Fails without a DNS lookup instead of calling home.
ENV OPENCHAMBER_UPDATE_API_URL=http://127.0.0.1:1/update

EXPOSE 4096

# OpenChamber writes its settings, so it gets a copy of the mount.
CMD ["sh", "-c", "cp /etc/opencode/openchamber.json ~/.config/openchamber/settings.json && exec openchamber --foreground --port 4096"]
