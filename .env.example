# Public-facing domain; *.PUBLIC_DOMAIN routes to session subdomains
PUBLIC_DOMAIN=mayfly.localhost
# External HTTPS port (Caddy)
PUBLIC_PORT=8443
# Local uvicorn port; Caddy reaches Mayfly via host.docker.internal:MAYFLY_PORT
MAYFLY_PORT=8123

DOCKER_IMAGE=mayfly:0.1.0
# Port the app listens on inside each session container
DOCKER_PORT=4096
DOCKER_NETWORK=mayfly-net

MAX_CONTAINERS=5
CONTAINER_MEMORY=3g
CONTAINER_CPUS=1.0
# tmpfs mount size for /home/user inside each container
CONTAINER_TMPFS_SIZE=2g
# Seconds before an unclaimed session is reaped
CONTAINER_START_TIMEOUT=60
# Seconds to keep a session alive after browser disconnect
CONTAINER_DISCONNECT_GRACE=30

# OpenAI-compatible endpoint plumbed into each container
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_MODEL=gemma4:e4b
OPENAI_CONTEXT_SIZE=131072
OPENAI_OUTPUT_SIZE=16384
