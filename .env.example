# Public hostname used in generated URLs.
PUBLIC_HOST=localhost
APP_PORT=8123
# Bind app locally or externally.
APP_BIND_HOST=127.0.0.1

TZ=Europe/Berlin

MAYFLY_IMAGE=mayfly:0.2.0
# Host port range for sandboxes.
MAYFLY_HOST_PORT_START=40000
MAYFLY_HOST_PORT_END=40100
# Bind sandbox ports locally or externally.
MAYFLY_BIND_HOST=127.0.0.1
MAYFLY_MAX_SESSIONS=5
MAYFLY_MEMORY=3g
MAYFLY_CPUS=1.0
# Ephemeral home size per sandbox.
MAYFLY_HOME_SIZE=2g
# Ephemeral /tmp size per sandbox.
MAYFLY_TMP_SIZE=64m
# Workspace directory inside the sandbox where navbar uploads are written.
MAYFLY_WORKSPACE_DIR=WORKSPACE
# Max upload size (supports k/m/g suffix).
MAYFLY_UPLOAD_LIMIT=512m
MAYFLY_CONNECT_TIMEOUT=60
MAYFLY_DISCONNECT_TIMEOUT=30

# LLM endpoint as seen from sandboxes.
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_API_KEY=whatever
OPENAI_MODEL=gemma4:26b
OPENAI_CONTEXT_TOKENS=65536
OPENAI_OUTPUT_TOKENS=32768
# Total request timeout in ms.
OPENAI_TIMEOUT=1800000
# Stream idle timeout in ms.
OPENAI_CHUNK_TIMEOUT=120000

PIP_INDEX_URL=https://pypi.org/simple
# Host without scheme; empty = verify TLS.
PIP_TRUSTED_HOST=
NPM_REGISTRY=https://registry.npmjs.org
NPM_STRICT_SSL=true
