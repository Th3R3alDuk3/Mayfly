PUBLIC_URL=http://127.0.0.1:8123

MAX_CONCURRENT_SANDBOXES=5

SANDBOX_IMAGE=mayfly:0.4.0
# memory in MiB, whole vCPUs
SANDBOX_MEMORY=3072
SANDBOX_CPUS=1
# seconds without an open browser connection until the sandbox is destroyed
SANDBOX_IDLE_TIMEOUT=120
# seconds; hard lifetime of each microVM
SANDBOX_MAX_DURATION=28800
# holds opencode.json; mounted read-only into every sandbox at /etc/mayfly
SANDBOX_CONFIG_DIR=./config
# all the sandbox may reach: `host:PORT` is this machine, otherwise DOMAIN[:PORT] (default 443)
SANDBOX_ALLOW=host:11434,pypi.org,files.pythonhosted.org

# image build args; the sandbox's pip and uv use the same index
PIP_INDEX_URL=https://pypi.org/simple
PIP_TRUSTED_HOST=
NPM_REGISTRY=https://registry.npmjs.org
NPM_STRICT_SSL=true
OPENCODE_VERSION=1.18.31
OPENCHAMBER_VERSION=1.24.1
