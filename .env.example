PUBLIC_URL=http://127.0.0.1:8123

# sessions at a time, so RAM up to this x SANDBOX_MEMORY
MAX_CONCURRENT_SANDBOXES=5

SANDBOX_IMAGE=mayfly-sandbox:latest
# where pip/uv and npm inside a session install from; reachable without listing them below
SANDBOX_INDEX_URL=https://pypi.org/simple
SANDBOX_NPM_REGISTRY=https://registry.npmjs.org
# set if an index uses an own certificate
SANDBOX_INSECURE_HOST=
# per session microVM: memory in MiB, whole vCPUs
SANDBOX_MEMORY=3072
SANDBOX_CPUS=1
# seconds without an open browser connection until the sandbox is destroyed
SANDBOX_IDLE_TIMEOUT=120
# seconds; hard lifetime of each microVM
SANDBOX_MAX_DURATION=28800
# all the sandbox may reach besides the indexes: `host:PORT` is this machine, otherwise DOMAIN[:PORT] or *.DOMAIN[:PORT] (default 443)
SANDBOX_ALLOW=openrouter.ai,github.com,*.github.com,*.githubusercontent.com
# file types the browser may upload; empty allows any
SANDBOX_UPLOAD_EXTENSIONS=.txt,.md,.json,.yaml,.csv,.py,.sh,.png,.jpg,.pdf,.zip
SANDBOX_UPLOAD_MAX_BYTES=104857600
