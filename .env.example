# Host the browser uses to reach mayfly sandboxes (each session gets its own host port)
PUBLIC_HOST=localhost
# Port the FastAPI app is reachable on
APP_PORT=8123
# Host IP the FastAPI app port is published on. 127.0.0.1 = local-only,
# 0.0.0.0 (or a LAN IP) = reachable from other machines.
APP_BIND_HOST=127.0.0.1

###

MAYFLY_IMAGE=mayfly:0.2.0
# Port openchamber listens on inside each mayfly sandbox container
MAYFLY_PORT=4096
# Host IP the sandbox ports are published on. 127.0.0.1 = local-only,
# 0.0.0.0 (or a LAN IP) = reachable from other machines.
MAYFLY_BIND_HOST=127.0.0.1
MAYFLY_NETWORK=mayfly-net
MAYFLY_MAX_SESSIONS=5
MAYFLY_MEMORY=3g
MAYFLY_CPUS=1.0
# tmpfs mount size for /home/user inside each mayfly
MAYFLY_TMPFS_SIZE=2g
# Seconds before an unclaimed session is reaped
MAYFLY_START_TIMEOUT=60
# Seconds to keep a session alive after browser disconnect
MAYFLY_DISCONNECT_GRACE=30

###

# OpenAI-compatible endpoint plumbed into each mayfly
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_MODEL=gemma4:e4b
OPENAI_CONTEXT_TOKENS=131072
OPENAI_OUTPUT_TOKENS=16384
# Total request timeout in ms. Generous for slow / cold-loading models.
OPENAI_TIMEOUT=1800000
# Inter-chunk stream timeout in ms — abort if no token for this long.
OPENAI_CHUNK_TIMEOUT=120000

###

# Timezone for app + mayfly containers (IANA name)
TZ=Europe/Berlin

###

# Build-time package mirrors for both Dockerfiles (override for offline / Nexus)
PIP_INDEX_URL=https://pypi.org/simple
# Host (no scheme) to skip TLS verification for, e.g. nexus.intern — empty = verify
PIP_TRUSTED_HOST=
NPM_REGISTRY=https://registry.npmjs.org
NPM_STRICT_SSL=true
