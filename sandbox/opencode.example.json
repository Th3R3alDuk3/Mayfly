{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["/etc/mayfly/AGENTS.md"],
  "enabled_providers": ["local"],
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://host.microsandbox.internal:8080/v1",
        "apiKey": "changeme",
        "timeout": false,
        "headerTimeout": false,
        "chunkTimeout": false
      },
      "models": {
        "Deepseek-v4.1-Flash:552b": {
          "tool_call": true,
          "modalities": {"input": ["text", "image"], "output": ["text"]},
          "limit": {"context": 65536, "output": 32768}
        }
      }
    }
  },
  "model": "local/Deepseek-v4.1-Flash:552b",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "bash": "allow",
    "task": "allow",
    "skill": "allow",
    "lsp": "allow",
    "question": "allow",
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny",
    "doom_loop": "ask"
  }
}
