{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["/etc/opencode/AGENTS.md"],
  "providers": {
    "local": {
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://host.microsandbox.internal:8080/v1",
        "apiKey": "changeme",
        "timeout": false,
        "headerTimeout": false,
        "chunkTimeout": false
      },
      "models": {
        "Deepseek-v4.1-Flash:552b": {
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {"context": 65536, "output": 32768}
        }
      }
    }
  },
  "model": "local/Deepseek-v4.1-Flash:552b",
  "policies": [
    {"action": "provider.use", "resource": "*", "effect": "deny"},
    {"action": "provider.use", "resource": "local", "effect": "allow"}
  ],
  "permissions": [
    {"action": "webfetch", "resource": "*", "effect": "deny"},
    {"action": "websearch", "resource": "*", "effect": "deny"},
    {"action": "experimental_image_generate", "resource": "*", "effect": "deny"},
    {"action": "external_directory", "resource": "*", "effect": "deny"}
  ]
}
